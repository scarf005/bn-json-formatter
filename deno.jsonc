{
  "tasks": {
    "dev": "deno run -A --node-modules-dir npm:vite",
    "build:wasm": "deno run --allow-env --allow-read --allow-write --allow-run --allow-net scripts/build-wasm.ts",
    "build": "deno task build:wasm && deno run -A --node-modules-dir npm:vite build",
    "check": "deno check src/main.tsx scripts/build-wasm.ts",
    "preview": "deno run -A --node-modules-dir npm:vite preview",
    "serve": "deno run --allow-net --allow-read jsr:@std/http@1/file-server dist/",
  },
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
  },
  "fmt": {
    "semiColons": false,
    "proseWrap": "never",
    "json.trailingCommas": "jsonc",
  },
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.5",
    "solid-js": "npm:solid-js@^1.9.10",
    "vite": "npm:vite@^7.2.7",
    "vite-plugin-solid": "npm:vite-plugin-solid@^2.11.10",
  },
}
